<?xml version="1.0" encoding="utf-8"?>
<!-- nh 字母标识：左 n 两竖一肩，右 h 以蓝色升部竖区分 -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- 两字肩线，圆头端点与竖线中心对齐，由竖线压出圆角拐角 -->
    <path
        android:fillColor="#00000000"
        android:pathData="M31,50L46,50"
        android:strokeWidth="7"
        android:strokeColor="#FBBC04"
        android:strokeLineCap="round" />
    <path
        android:fillColor="#00000000"
        android:pathData="M62,50L77,50"
        android:strokeWidth="7"
        android:strokeColor="#FBBC04"
        android:strokeLineCap="round" />
    <!-- n 左竖取红，与蓝色升部分居两端，凑齐 Google 四色 -->
    <path
        android:fillColor="#00000000"
        android:pathData="M31,50L31,72"
        android:strokeWidth="7"
        android:strokeColor="#EA4335"
        android:strokeLineCap="round" />
    <path
        android:fillColor="#00000000"
        android:pathData="M46,50L46,72"
        android:strokeWidth="7"
        android:strokeColor="#34A853"
        android:strokeLineCap="round" />
    <path
        android:fillColor="#00000000"
        android:pathData="M77,50L77,72"
        android:strokeWidth="7"
        android:strokeColor="#34A853"
        android:strokeLineCap="round" />
    <!-- h 的升部竖，是全图唯一超出 x-height 的笔画 -->
    <path
        android:fillColor="#00000000"
        android:pathData="M62,36L62,72"
        android:strokeWidth="7"
        android:strokeColor="#1A73E8"
        android:strokeLineCap="round" />
</vector>
